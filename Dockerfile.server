FROM node:22-alpine
WORKDIR /app
# Fetch pre-built server from public repo at startup-capable build time
RUN apk add --no-cache curl \
 && curl -sL https://github.com/rjarem/netspace/archive/3b87b95.tar.gz | tar xz --strip-components=1 \
 && npm install -g pnpm@12 \
 && cd packages/server \
 && pnpm install --frozen-lockfile --ignore-scripts
WORKDIR /app/packages/server
EXPOSE 2567
CMD ["node", "dist/index.js"]